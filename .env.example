# Copier en .env.local (jamais commité) et dans les variables d'environnement Vercel.
RESEND_API_KEY=
# Chaîne de connexion Neon de la base Bitumad (Neon > projet > Connection string, mode "pooled").
DATABASE_URL=
# 32 caractères minimum, ex. : openssl rand -base64 48
ADMIN_SESSION_SECRET=
# Optionnel : sel du hash visiteur des statistiques (dérivé de ADMIN_SESSION_SECRET sinon).
ANALYTICS_SALT=
# Optionnel : transmet chaque formulaire à l'ERP (file « Demandes du site »).
# URL : https://<domaine de l'ERP>/api/inbound/site ; secret identique à SITE_INBOUND_SECRET côté ERP.
# Une demande que l'ERP n'a pas reçue est renvoyée automatiquement pendant 7 jours (lib/erp.ts).
ERP_INBOUND_URL=
ERP_INBOUND_SECRET=
# Optionnel : jeton de la route d'usage lue par l'ERP (/api/oxmad/usage, visiteurs uniques par jour sur le mois).
# À copier depuis l'ERP : fiche du projet > Type et quotas > « Copier le jeton du site ».
OXMAD_USAGE_TOKEN=
# Chaîne aléatoire (openssl rand -base64 32) : Vercel l'envoie à la relance quotidienne vers l'ERP (/api/cron/erp-sync).
CRON_SECRET=
