# Copier en .env.local (jamais commité) et dans les variables d'environnement Vercel.
RESEND_API_KEY=
# Chaîne de connexion Neon de la base Bitumad (Neon > projet > Connection string, mode "pooled").
DATABASE_URL=
# 32 caractères minimum, ex. : openssl rand -base64 48
ADMIN_SESSION_SECRET=
# Optionnel : sel du hash visiteur des statistiques (dérivé de ADMIN_SESSION_SECRET sinon).
ANALYTICS_SALT=
